# Sem DATABASE_URL, a API roda em Postgres na memória (pg-mem) para dev/teste.
# Em produção (servidor on-premise), aponte para o PostgreSQL:
DATABASE_URL=postgres://contato:contato@localhost:5432/contato

# Segredo do JWT (troque em produção!)
JWT_SECRET=troque-este-segredo
JWT_EXPIRA=8h

# Porta da API
PORT=3333
